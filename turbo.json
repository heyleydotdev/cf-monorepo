{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "globalDependencies": [".env*"],
  "tasks": {
    "generate-routes": {
      "description": "TanStack Start: regenerate apps/tanstack/src/routeTree.gen.ts from the file routes",
      "outputs": ["src/routeTree.gen.ts"]
    },
    "build": {
      "dependsOn": ["generate-routes"],
      "outputs": [
        "dist/**",
        ".cache/**",
        ".tanstack/**",
        ".output/**",
        ".cloudflare/output/**"
      ]
    },
    "typegen": {
      "description": "Wrangler: regenerate each app's committed worker-configuration.d.ts"
    },
    "generate": {
      "description": "Drizzle Kit: turn a schema change in packages/db into SQL migration files",
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "migrate:remote": {
      "cache": false
    },
    "typecheck-transit": {
      "dependsOn": ["^typecheck-transit"]
    },
    "typecheck": {
      "dependsOn": ["typecheck-transit", "generate-routes"]
    },
    "lint": {
      "dependsOn": ["generate-routes"]
    },
    "test": {},
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^dev"],
      "persistent": false,
      "cache": false
    },
    "format": {},
    "format:write": {
      "cache": false
    },
    "//#format:root": {
      "inputs": ["*.md", "*.json", ".vscode/*.json"]
    },
    "//#format:write:root": {
      "cache": false,
      "inputs": ["*.md", "*.json", ".vscode/*.json"]
    },
    "deploy": {
      "cache": false
    }
  }
}
