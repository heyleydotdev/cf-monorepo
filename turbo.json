{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "generate-routes": {
      "cache": false,
      "outputs": ["src/routeTree.gen.ts"]
    },
    "build": {
      "dependsOn": ["generate-routes"],
      "outputs": ["dist/**", ".cache/**", ".tanstack/**", ".output/**"]
    },
    "typegen": {},
    "typecheck": {
      "dependsOn": ["^typecheck", "generate-routes"]
    },
    "lint": {
      "dependsOn": ["generate-routes"]
    },
    "test": {},
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^dev"],
      "persistent": false,
      "cache": false
    },
    "format": {},
    "format:write": {
      "cache": false
    },
    "deploy": {
      "cache": false
    }
  }
}