{
  "name": "cf-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "prettier": "3.9.9",
      "typescript": "5.9.3",
      "@types/node": "22.20.3",
      "eslint": "10.10.0",
      "zod": "4.6.5",
      "tailwindcss": "4.3.3",
      "@tailwindcss/vite": "4.3.3",
      "@tailwindcss/postcss": "4.3.3",
      "wrangler": "4.148.0",
      "vitest": "~4.1.0",
      "@cloudflare/workers-types": "5.20260921.1",
      "@cloudflare/vitest-plugin": "1.1.12",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.2",
      "vite": "8.3.3"
    }
  },
  "scripts": {
    "dev": "turbo watch dev --continue",
    "clean": "turbo run clean",
    "build": "turbo run build",
    "typegen": "turbo run typegen",
    "generate": "turbo run generate",
    "migrate": "turbo run migrate",
    "migrate:remote": "turbo run migrate:remote",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "turbo run format format:root",
    "format:write": "turbo run format:write format:write:root",
    "format:root": "prettier --check \"*.md\" \"*.json\" \".vscode/*.json\"",
    "format:write:root": "prettier --write \"*.md\" \"*.json\" \".vscode/*.json\""
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@acme/prettier": "workspace:*",
    "@ianvs/prettier-plugin-sort-imports": "^4.0.0",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.13"
  },
  "prettier": "@acme/prettier"
}
