{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /* Environment */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Modules */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowArbitraryExtensions": true,

    /* JSX */
    "jsx": "react-jsx"
  }
}
