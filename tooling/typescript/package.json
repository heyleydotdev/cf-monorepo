{
  "name": "@acme/tsconfig",
  "version": "0.1.0",
  "private": true,
  "files": [
    "*.json"
  ],
  "scripts": {
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:write": "prettier --write . --ignore-path ../../.gitignore"
  },
  "devDependencies": {
    "@acme/prettier": "workspace:*",
    "prettier": "catalog:"
  },
  "prettier": "@acme/prettier"
}
