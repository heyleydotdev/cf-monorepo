{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /* Modules: bundled Worker, sources consumed directly. */
    "module": "es2022",
    "moduleResolution": "bundler",

    /* Environment: Workers runtime globals (Request, Response, fetch). */
    "types": ["@cloudflare/workers-types"]
  }
}
