{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /* Modules: bundled library, sources consumed directly. */
    "module": "esnext",
    "moduleResolution": "bundler",

    /* Emit declarations only; consumers bundle TS sources directly. */
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src"
  }
}
