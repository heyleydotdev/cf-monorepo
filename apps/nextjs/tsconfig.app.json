{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@acme/tsconfig/browser.json",
  "compilerOptions": {
    /* vinext runs the RSC transform; TS must not emit react-jsx itself. */
    "jsx": "preserve",

    /* vinext's next/* types plus node globals. */
    "types": ["vinext/types", "node"],

    /* vinext reads the `~/*` alias from tsconfig paths itself, so no Vite
       `resolve.tsconfigPaths` is needed. */
    "paths": {
      "~/*": ["./*"]
    }
  },
  /* next.config.ts needs bundler resolution; the rest are generated by a build. */
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "app",
    ".next/types/**/*.ts",
    ".cloudflare/types"
  ]
}
