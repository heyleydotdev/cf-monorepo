{
  "name": "@acme/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf dist .cache",
    "dev": "wrangler dev --env-file ../../.env",
    "start": "wrangler dev --env-file ../../.env",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "migrate": "wrangler d1 migrations apply acme-db --local",
    "migrate:remote": "wrangler d1 migrations apply acme-db --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "format:write": "prettier --write . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@acme/api": "workspace:*",
    "@acme/core": "workspace:*",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@acme/eslint": "workspace:*",
    "@acme/prettier": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "~4.1.0",
    "wrangler": "catalog:"
  },
  "prettier": "@acme/prettier"
}
