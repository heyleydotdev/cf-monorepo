{
  "name": "@acme/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf dist .cache",
    "dev": "wrangler dev --env-file ../../.env",
    "start": "wrangler dev --env-file ../../.env",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "migrate": "wrangler d1 migrations apply acme-db --local",
    "migrate:remote": "wrangler d1 migrations apply acme-db --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "bun fmt --check --no-script . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "format:write": "bun fmt --no-script . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint .",
    "typecheck": "bun check -b --no-script"
  },
  "dependencies": {
    "@acme/api": "workspace:*"
  },
  "devDependencies": {
    "@acme/eslint": "workspace:*",
    "@acme/prettier": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@acme/vitest": "workspace:*",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "prettier": "@acme/prettier"
}
