// Cloudflare Workers docs: https://developers.cloudflare.com/workers/wrangler/configuration/
// Non-secret values only. Use `wrangler secret put NAME` for secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "observability": {
    "enabled": true,
  },
  "dev": {
    "host": "0.0.0.0",
    "port": 3001,
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acme-db",
      // Placeholder so a clone runs against local D1 with no account. Replace
      // with the id from `wrangler d1 create acme-db`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "vars": {},
}
