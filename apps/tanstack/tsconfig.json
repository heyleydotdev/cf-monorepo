{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@acme/tsconfig/browser.json",
  "compilerOptions": {
    /* Bundler-only: lets source imports carry a .ts extension */
    "allowImportingTsExtensions": true,

    "types": ["vite/client"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "eslint.config.js", "vite.config.ts", "tsr.config.json"]
}
