{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@acme/tsconfig/browser.json",
  "compilerOptions": {
    /* Bundler-only: lets source imports carry a .ts extension */
    "allowImportingTsExtensions": true,

    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
