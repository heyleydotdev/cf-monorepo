{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@acme/tsconfig/browser.json",
  "compilerOptions": {
    /* Bundler-only: lets source imports carry a .ts extension */
    "allowImportingTsExtensions": true,

    /* src/server.ts and the api routes it pulls in run on Workers, so the
       D1Database binding has to resolve here too. */
    "types": ["vite/client", "@cloudflare/workers-types"],

    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
