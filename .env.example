# Shared .env at the repo root. Read by `wrangler dev --env-file ../../.env`
# and, for apps/tanstack, by Vite through `envDir` in vite.config.ts.
# Production secrets go through `wrangler secret put NAME`, never into
# wrangler.jsonc.
#
# VITE_ is Vite's public prefix and is compiled into the client bundle, so the
# value is fixed at build time. Unprefixed vars stay server-side.

# Public var, mirrored in wrangler.jsonc "vars".
EXAMPLE_PUBLIC_VAR=

# Secret, never in wrangler.jsonc.
EXAMPLE_SECRET=

# D1 migrations are applied with `wrangler d1 migrations apply`, which reads
# the binding from the app's wrangler config and authenticates through the
# wrangler login. No D1 credentials in this file; see
# packages/db/drizzle.config.ts if you ever need drizzle-kit's own driver.

# No VITE_ vars yet. The TanStack app reaches its data through server
# functions that run in the same Worker, so it never needs its own origin.
