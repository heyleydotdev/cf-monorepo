# Shared .env at the repo root. Read by `wrangler dev --env-file ../../.env`
# and, for apps/tanstack, by Vite through `envDir` in vite.config.ts.
# Production secrets go through `wrangler secret put NAME`, never into
# wrangler.jsonc.

# Public var, mirrored in wrangler.jsonc "vars".
EXAMPLE_PUBLIC_VAR=

# Secret, never in wrangler.jsonc.
EXAMPLE_SECRET=

# Where the TanStack app can reach its own origin. The RPC loader runs on the
# server and needs an absolute URL, so this cannot be a relative path. Exposed
# through `envPrefix` in apps/tanstack/vite.config.ts.
TANSTACK_BASE_URL=http://localhost:3000