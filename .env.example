# Shared .env at the repo root. Read by `wrangler dev --env-file ../../.env`
# and, for apps/tanstack, by Vite through `envDir` in vite.config.ts.
# Production secrets go through `wrangler secret put NAME`, never into
# wrangler.jsonc.
#
# VITE_ is Vite's public prefix and is compiled into the client bundle, so the
# value is fixed at build time. Unprefixed vars stay server-side.

# Public var, mirrored in wrangler.jsonc "vars".
EXAMPLE_PUBLIC_VAR=

# Secret, never in wrangler.jsonc.
EXAMPLE_SECRET=

# Absolute origin the TanStack app reaches itself on; the RPC loader runs on
# the server and cannot use a relative path.
VITE_TANSTACK_BASE_URL=http://localhost:3000
