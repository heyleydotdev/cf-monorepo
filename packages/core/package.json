{
  "name": "@acme/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./services/*": "./src/services/*.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:write": "prettier --write . --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint": "workspace:*",
    "@acme/prettier": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier"
}
