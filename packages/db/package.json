{
  "name": "@acme/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./sql": "./src/sql.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "bun check --no-script",
    "lint": "eslint .",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "format:write": "prettier --write . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@acme/eslint": "workspace:*",
    "@acme/prettier": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier"
}
