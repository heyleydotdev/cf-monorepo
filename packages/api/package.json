{
  "name": "@acme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:write": "prettier --write . --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "@acme/core": "workspace:*",
    "@acme/db": "workspace:*",
    "@orpc/client": "2.0.0-beta.43",
    "@orpc/openapi": "2.0.0-beta.43",
    "@orpc/server": "2.0.0-beta.43",
    "@orpc/tanstack-query": "2.0.0-beta.43",
    "@tanstack/query-core": "5.104.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint": "workspace:*",
    "@acme/prettier": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier"
}
