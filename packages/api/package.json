{
  "name": "@acme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./src/app.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "git clean -xdf dist .cache",
    "build": "tsc",
    "dev": "tsc",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "lint": "eslint .",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:write": "prettier --write . --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "@cloudflare/workers-types": "catalog:",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@acme/eslint": "workspace:*",
    "@acme/prettier": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier"
}
