{
  "name": "@acme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:write": "prettier --write . --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "@acme/core": "workspace:*",
    "@acme/db": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@hono/zod-validator": "catalog:",
    "hono": "^4.13.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint": "workspace:*",
    "@acme/prettier": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier"
}
