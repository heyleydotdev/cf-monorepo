{
  "name": "@acme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "bun check --no-script",
    "lint": "eslint .",
    "format": "bun fmt --check --no-script . --ignore-path ../../.gitignore",
    "format:write": "bun fmt --no-script . --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "@acme/core": "workspace:*",
    "@acme/db": "workspace:*",
    "@orpc/client": "^2.0.0-beta.44",
    "@orpc/openapi": "^2.0.0-beta.44",
    "@orpc/server": "^2.0.0-beta.44",
    "@orpc/tanstack-query": "^2.0.0-beta.44",
    "@orpc/zod": "^2.0.0-beta.44",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint": "workspace:*",
    "@acme/prettier": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier"
}
